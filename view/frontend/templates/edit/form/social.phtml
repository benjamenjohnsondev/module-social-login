<?php

/** @var \BenJohnsonDev\SocialLogin\Block\Form\Edit $block */
/** @var \Magento\Framework\Escaper $escaper */

if (!$block->isCustomerSocialLogin()) {
    return;
}
?>
<div class="social-login-account-section">
    <div class="social-login-linked-account">
        <i class="<?= $block->escapeHtmlAttr($block->getProvider()->getIcon()) ?>"></i>
        <span><?= $block->escapeHtml(__('Your account is linked with %1', $block->getProviderLabel())) ?></span>
    </div>

    <p class="social-login-notice">
        <?= $block->escapeHtml(__(
            'Your account uses %1 for authentication. To enable password login, unlink your account below.',
            $block->getProviderLabel()
        )) ?>
    </p>

    <div class="field choice social-login-unlink">
        <input type="checkbox"
               name="unlink_social"
               id="unlink-social"
               value="<?= $block->escapeHtmlAttr($block->getProviderCode()) ?>"
               class="checkbox"/>
        <label class="label" for="unlink-social">
            <span><?= $block->escapeHtml(__('Unlink %1 account', $block->getProviderLabel())) ?></span>
        </label>
    </div>
</div>

<script type="text/x-magento-init">
{
    "#unlink-social": {
        "BenJohnsonDev_SocialLogin/js/unlink": {}
    }
}
</script>
